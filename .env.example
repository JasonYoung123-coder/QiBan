# Optional legacy defaults. Configure connections in the app Settings UI.
# Never put real keys in this example file.
CHAT_PROVIDER=openai
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_KEY=
CHAT_REQUIRE_API_KEY=true
CHAT_TIMEOUT_SECONDS=60
# 0 omits the token-budget field for gateway compatibility.
CHAT_MAX_TOKENS=0

# Optional: endpoints below must implement the OpenAI-compatible audio contract.
# Native Qwen / CosyVoice servers need a matching adapter; filling an arbitrary URL is not enough.
STT_BASE_URL=
STT_MODEL=
STT_API_KEY=
# Selected voice: Volcengine V3. Fill only the API key locally.
TTS_PROVIDER=volcengine
VOLCENGINE_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_SPEAKER=zh_female_sajiaoxuemei_uranus_bigtts
# Legacy compatible service fields below apply only when TTS_PROVIDER=openai.
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=
TTS_API_KEY=
WINDOWS_TTS_ENABLED=true

# Optional real-time voice. Requires a running LiveKit server AND backend.voice_worker.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
WORKER_SECRET=

# SQLite is only the local prototype default. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://companion:YOUR_PASSWORD@127.0.0.1:5432/companion
